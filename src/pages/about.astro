---
import PageHeader from '@/components/PageHeader.astro';
import Shape from '@/components/Shape.astro';
import Base from '@/layouts/Base.astro';
import CounterComponent from '@/layouts/components/about/CounterComponent.astro';
import Gallery from '@/layouts/components/about/Gallery.astro';
import OurMembers from '@/layouts/components/about/OurMembers.astro';
import Works from '@/layouts/components/about/Works.astro';
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';

const about = (await getEntry('about', '-index')) as CollectionEntry<'about'>;
const { counter, gallery, features, members } = about.data;
const pageData = {
  ...about.data,
  content: about.body
};
---

<Base
  title={about.data.title}
  metaTitle={about.data.metaTitle}
  description={about.data.description}
  image={about.data.image}
>
  <Shape />
  <section class="page-hero py-16">
    <div class="container">
      <div class="page-hero-content mx-auto max-w-[768px] text-center">
        <PageHeader pageData={pageData} />
      </div>
      <CounterComponent counter={counter} />
      <Gallery gallery={gallery} />
      <Works features={features} />
      <OurMembers members={members} />
    </div>
  </section>
</Base>
