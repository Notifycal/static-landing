---
import Blog from '@/components/Blog.astro';
import BlogCategories from '@/components/blog/BlogCategories.astro';
import PageHeader from '@/components/PageHeader.astro';
import Base from '@/layouts/Base.astro';
import { getSinglePage } from '@/lib/contentParser.astro';
import { getTaxonomy } from '@/lib/taxonomyParser.astro';
import taxonomyFilter from '@/lib/utils/taxonomyFilter';
import { slugify } from '@/lib/utils/textConverter';

const categories = await getTaxonomy('blog', 'categories');
export async function getStaticPaths() {
  const categories = await getTaxonomy('blog', 'categories');
  return categories.map((item) => {
    const category = slugify(item);
    return {
      params: { category },
      props: {
        item
      }
    };
  });
}

const { category } = Astro.params;
const { item } = Astro.props;

const posts = await getSinglePage('blog');
const filterByTags = taxonomyFilter(posts, 'categories', category!);
const pageData = {
  indexTitle: 'Categories',
  slug: item
};
---

<Base title={category!}>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-content max-w-[883px]">
        <PageHeader pageData={pageData} />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <BlogCategories categories={categories} />
      <Blog posts={filterByTags} />
    </div>
  </section>
</Base>
