---
import CareerSidebar from '@/components/career/CareerSidebar.astro';
import PageHeader from '@/components/PageHeader.astro';
import Shape from '@/components/Shape.astro';
import Base from '@/layouts/Base.astro';
import { getSinglePage } from '@/lib/contentParser.astro';
import similarItems from '@/lib/utils/similarItems';
import { getEntry, render } from 'astro:content';

const careerIndex = await getEntry('careers', '-index');
const careers = await getSinglePage('careers');
export async function getStaticPaths() {
  const careers = await getSinglePage('careers');
  const paths = careers.map((post) => ({
    params: {
      single: post.id
    },
    props: { post }
  }));
  return paths;
}
const { post } = Astro.props;
const { Content } = await render(post);
const similarPosts = similarItems(post, careers, post.id);

const pageData = {
  indexTitle: careerIndex?.data.title,
  pageTitle: post.data.title,
  slug: post.id
};
---

<Base
  title={post.data.title}
  metaTitle={post.data.metaTitle}
  description={post.data.description}
  image={post.data.image}
>
  <Shape />
  <section class="page-hero pt-16 pb-14">
    <div class="container">
      <div class="page-hero-content mx-auto max-w-[883px] text-center">
        <PageHeader pageData={pageData} />
      </div>
    </div>
  </section>
  <section class="section career-single pt-0">
    <div class="container">
      <div class="lg:gx-4 row">
        <div class="lg:col-8">
          <div class="content rounded-xl bg-white p-7 shadow-lg lg:px-12 lg:py-[60px]">
            <Content />
          </div>
        </div>
        <CareerSidebar posts={similarPosts.slice(0, 1)} sidebarContent={careerIndex?.data.sidebarContent} />
      </div>
    </div>
  </section>
</Base>
