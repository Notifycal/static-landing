---
import PricingItem from '../components/PricingItem.astro';
---

<div class="mx-auto max-w-5xl px-8 py-24">
  <div class="mb-20 flex w-full flex-col text-center">
    <div class="mb-4">
      <div class="badge badge-accent animate-pulse whitespace-nowrap">✨ Launch discount — $50 OFF ✨</div>
    </div><h2 class="mx-auto mb-8 max-w-xl text-3xl font-bold tracking-tight lg:text-5xl">
      Stop wasting hours managing Stripe invoices
    </h2><div class="text-base-content-secondary mx-auto max-w-md">
      Ditch the Stripe Invoicing fee, reduce customer support, and focus on your startup. 1-minute no-code setup.
    </div>
  </div>
  <div class="relative flex flex-col items-center justify-center gap-8 lg:flex-row lg:items-stretch">
    <PricingItem
      listItems={['ZenVoice link', 'Unlimited self-serve invoices', '1 Stripe account']}
      buttonLink="#"
      price="99"
      offerPrice="49"
    />
    <PricingItem
      listItems={['ZenVoice link', 'Unlimited self-serve invoices', 'Unlimited Stripe accounts']}
      buttonLink="#"
      price="119"
      offerPrice="69"
      isHighlighted="true"
      highlightText="BUSY FOUNDERS' CHOICE"
    />
  </div>
  <div class="mx-auto mt-16 max-w-md space-y-4 md:mt-24 md:space-y-6">
    <div class="rating !flex justify-center">
      {
        [...Array(5).keys()].map((_) => (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-5 w-5 text-yellow-500"
          >
            <path
              fill-rule="evenodd"
              d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z"
              clip-rule="evenodd"
            />
          </svg>
        ))
      }
    </div><div class="mx-auto max-w-md space-y-2 text-center text-base leading-relaxed">
      <p>
        Not having to make invoices manually is<!-- -->
        <span class="bg-yellow-100/80 px-1.5">saving me tons of support work.</span>
        <!-- -->Now I can just send a link to customers and they handle everything themselves
      </p>
    </div><div class="flex items-center justify-center gap-3 md:gap-4">
      <img
        alt="Nico J. feedback for ZenVoice"
        loading="lazy"
        width="48"
        height="48"
        decoding="async"
        data-nimg="1"
        class="h-10 w-10 rounded-full object-cover md:h-12 md:w-12"
        style="color:transparent"
        srcset="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fbangkok.5b2524a0.jpg&w=48&q=75 1x, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fbangkok.5b2524a0.jpg&w=96&q=75 2x"
        src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fbangkok.5b2524a0.jpg&w=96&q=75"
      /><div>
        <p class="font-semibold">Nico Jeannen</p><p class="text-base-content-secondary text-sm">21.7K followers on 𝕏</p>
      </div>
    </div>
  </div>
</div>
