---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<script is:inline src={`https://accounts.google.com/gsi/client?hl=${lang}`} async></script>
<div class="flex flex-grow basis-0 justify-end">
  <button class="lg:hidden" id="google-login-button-small"></button>
  <button class="hidden lg:inline-flex" id="google-login-button"></button>
</div>

<script is:inline define:vars={{ lang }}>
  const { GOOGLE_CLIENT_ID } = window.globalConfig;

  function handleCredentialResponse(response) {
    // Do redirect with JS
    console.log('Encoded JWT ID token: ' + response.credential);
  }

  function renderLoginButton(elementId) {
    const type = elementId.includes('small') ? 'icon' : 'standard';
    const buttonEl = document.getElementById(elementId);

    buttonEl &&
      window.google.accounts.id.renderButton(
        buttonEl,
        { type, theme: 'outline', size: 'large', locale: lang, text: 'signin' } // customization attributes
      );
  }

  window.onload = function () {
    window.google.accounts.id.initialize({
      client_id: GOOGLE_CLIENT_ID,
      callback: handleCredentialResponse
    });

    renderLoginButton('google-login-button-small');
    renderLoginButton('google-login-button');
  };
</script>
