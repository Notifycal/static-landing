---
import { Image } from 'astro:assets';

import type { ui } from '../i18n/ui';

import { useTranslations } from '../i18n/utils';
import PricingSection from '../sections/PricingSection.astro';
import BackgroundGenerated from './BackgroundGenerated.astro';
import Header from './Header.astro';

import googleCalLogo from '../images/google-calendar-logo.svg';
import whatsappLogo from '../images/whatsapp-logo.svg';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;

const t = useTranslations(lang);


// FIX this
const listItems = ['1-minute no-code setup', 'Reduce customer support', 'No 0.4% Stripe invoice fee'];
---

<main class="min-h-screen">
  <section class="relative overflow-hidden md:min-h-[100vh]">
    <div class="absolute inset-0 z-0 block">
      <BackgroundGenerated />
    </div>
    <Header />
    <div
      class="relative z-10 mx-auto flex max-w-5xl flex-col items-center justify-center gap-16 px-8 py-12 lg:gap-20 lg:py-32"
    >
      <div class="relative flex flex-col items-center justify-center gap-10 text-center lg:gap-12">
        <div class="space-y-2">
          <div class="font-medium flex items-center justify-center text-xs">
            Powered by <img
              alt="Google Calendar"
              title="Google Calendar"
              fetchpriority="high"
              width="70"
              decoding="async"
              data-nimg="1"
              class="mx-1 inline w-6"
              style="color:transparent"
              src={googleCalLogo.src}
            /> and <img
              alt="Whatsapp"
              title="Whatsapp"
              fetchpriority="high"
              width="70"
              decoding="async"
              data-nimg="1"
              class="mx-1 inline w-8"
              style="color:transparent"
              src={whatsappLogo.src}
            />
          </div>
          <h1 class="text-4xl font-extrabold tracking-tight md:-mb-4 lg:text-6xl">
            {t('hero_0')}<br />{t('hero_1')}
          </h1>
        </div><p class="text-base-content-secondary mx-auto max-w-md text-lg leading-relaxed">
          Let your customers generate, edit, and download Stripe invoices, so you don’t have to.
        </p>
        <ul class="text-base-content-secondary hidden space-y-1 leading-relaxed md:block">
          {
            listItems.map((string) => (
              <li class="flex items-center justify-center gap-2 lg:justify-start">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-[18px] w-[18px] text-primary"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                    clip-rule="evenodd"
                  />
                </svg>
                {string}
              </li>
            ))
          }
        </ul>
        <a
          class="group btn btn-primary !btn-wide btn-block"
          href="https://buy.stripe.com/eVa00O1Zmd5BeEobIJ?prefilled_promo_code=LAUNCH">Get Notifycal</a
        >
        <!-- <UsersRating /> -->
      </div>
    </div>
  </section>
  <section class="text-base-content"></section>
  <section class="bg-base-200 overflow-hidden" id="pricing">
    <PricingSection />
  </section>


  <footer class="footer p-10 bg-base-200 text-base-content">
    <aside>
      <svg width="50" height="50" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill-rule="evenodd" clip-rule="evenodd" class="fill-current"><path d="M22.672 15.226l-2.432.811.841 2.515c.33 1.019-.209 2.127-1.23 2.456-1.15.325-2.148-.321-2.463-1.226l-.84-2.518-5.013 1.677.84 2.517c.391 1.203-.434 2.542-1.831 2.542-.88 0-1.601-.564-1.86-1.314l-.842-2.516-2.431.809c-1.135.328-2.145-.317-2.463-1.229-.329-1.018.211-2.127 1.231-2.456l2.432-.809-1.621-4.823-2.432.808c-1.355.384-2.558-.59-2.558-1.839 0-.817.509-1.582 1.327-1.846l2.433-.809-.842-2.515c-.33-1.02.211-2.129 1.232-2.458 1.02-.329 2.13.209 2.461 1.229l.842 2.515 5.011-1.677-.839-2.517c-.403-1.238.484-2.553 1.843-2.553.819 0 1.585.509 1.85 1.326l.841 2.517 2.431-.81c1.02-.33 2.131.211 2.461 1.229.332 1.018-.21 2.126-1.23 2.456l-2.433.809 1.622 4.823 2.433-.809c1.242-.401 2.557.484 2.557 1.838 0 .819-.51 1.583-1.328 1.847m-8.992-6.428l-5.01 1.675 1.619 4.828 5.011-1.674-1.62-4.829z"></path></svg>
      <p>Notifycal<br>Providing reliable tech since 1992</p>
    </aside> 
    <nav>
      <h6 class="footer-title">Services</h6> 
      <a class="link link-hover">Branding</a>
      <a class="link link-hover">Design</a>
      <a class="link link-hover">Marketing</a>
      <a class="link link-hover">Advertisement</a>
    </nav> 
    <nav>
      <h6 class="footer-title">Company</h6> 
      <a class="link link-hover">About us</a>
      <a class="link link-hover">Contact</a>
      <a class="link link-hover">Jobs</a>
      <a class="link link-hover">Press kit</a>
    </nav> 
    <nav>
      <h6 class="footer-title">Legal</h6> 
      <a class="link link-hover">Terms of use</a>
      <a class="link link-hover">Privacy policy</a>
      <a class="link link-hover">Cookie policy</a>
    </nav>
  </footer>
</main>

<script>
  const { GOOGLE_CLIENT_ID } = import.meta.env;

  function handleCredentialResponse(response: any) {
    // Do redirect with JS
    console.log('Encoded JWT ID token: ' + response.credential);
  }
  window.onload = function () {
    google.accounts.id.initialize({
      client_id: '848746665654-6bro4lcu48pj3d5gprub1kj0pvp63hh0.apps.googleusercontent.com',
      callback: handleCredentialResponse
    });
    google.accounts.id.renderButton(
      document.getElementById('google-login-button-small'),
      { type: 'icon', theme: 'outline', size: 'large' } // customization attributes
    );
    google.accounts.id.renderButton(
      document.getElementById('google-login-button'),
      { theme: 'outline', size: 'large' } // customization attributes
    );
    // google.accounts.id.prompt(); // also display the One Tap dialog
  };
</script>

