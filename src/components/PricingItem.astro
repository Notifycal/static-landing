---
const { listItems, buttonLink, price, offerPrice, isHighlighted = false, highlightText } = Astro.props;
---

<div class="relative w-full max-w-lg">
  {
    isHighlighted && (
      <>
        <div class="absolute left-1/2 top-0 z-20 -translate-x-1/2 -translate-y-1/2">
          <span class="badge whitespace-nowrap border-0 bg-primary text-xs font-medium text-primary-content">
            {highlightText}
          </span>
        </div>
        <div class="absolute -inset-[1px] z-10 rounded-[9px] bg-primary" />
      </>
    )
  }
  <div class="relative z-10 flex h-full flex-col gap-5 rounded-lg bg-base-100 p-8 lg:gap-8">
    <div class="flex flex-wrap gap-2">
      <div class="mb-[4px] flex flex-col justify-end text-lg">
        <p class="relative">
          <span class="absolute inset-x-0 top-[53%] h-[1.5px] bg-base-content"></span><span class="text-base-content/80"
            >{price}<!-- -->&euro;</span
          >
        </p>
      </div>
      <p class="text-5xl font-extrabold tracking-tight">{offerPrice}<!-- -->&euro;</p><div
        class="mb-[4px] flex flex-col justify-end"
      >
        <p class="text-xs font-semibold uppercase text-base-content/60">EUR</p>
      </div>
    </div>
    <ul class="flex-1 space-y-2.5 text-base leading-relaxed">
      {
        listItems.map((item: string) => (
          <li class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-[18px] w-[18px] shrink-0 opacity-80"
            >
              <path
                fill-rule="evenodd"
                d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                clip-rule="evenodd"
              />
            </svg>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
    <div class="space-y-2">
      <a class="group btn btn-primary btn-block" href={buttonLink}
        >Get <!-- -->ZenVoice<svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-[18px] w-[18px] fill-white/10 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:fill-white/20"
          ><path d="m3 3 3 9-3 9 19-9Z"></path><path d="M6 12h16"></path></svg
        >
      </a>
      <p class="text-base-content-secondary relative text-center text-sm font-medium">
        One-time payment, then<!-- -->
        <span class="underline">it's yours forever</span>
      </p>
    </div>
  </div>
</div>
