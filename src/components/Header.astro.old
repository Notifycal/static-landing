---
import { Icon } from 'astro-icon/components';

import { defaultLang, hideDefaultLang, languages } from '../i18n/ui';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import GoogleAccount from './GoogleAccount.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import type { ImageMetadata } from 'astro';
import caFlag from '../icons/i18n/ca-flag.png';
import enFlag from '../icons/i18n/en-flag.svg';
import esFlag from '../icons/i18n/es-flag.svg';

const flags: Record<keyof typeof languages, ImageMetadata> = {
  en: enFlag,
  es: esFlag,
  ca: caFlag
};
---

<header class="relative z-20 py-3">
  <div class="navbar container mx-auto flex max-w-5xl items-center justify-between px-8 py-4">
    <div class="navbar-start">
      <div class="dropdown">
        <div tabindex="0" role="button" class="btn btn-ghost active:!bg-primary md:hidden">
          <Icon name="mdi:menu" size={26} />
        </div>
        <ul
          class="menu dropdown-content menu-sm rounded-box bg-base-100 [&>li>a:active]:!bg-primary z-20 mt-3 w-52 p-2 shadow"
        >
          <li>
            <a href="#faq">{t('nav.faq')}</a>
          </li>
          <li>
            <a href="#pricing">{t('nav.pricing')}</a>
          </li>
          <li>
            <details open>
              <summary class="active:!bg-primary">{t('nav.language')}</summary>
              <ul class="[&>li>a:active]:!bg-primary p-2">
                {
                  Object.entries(languages).map(([lang, label]) => (
                    <li>
                      <a href={lang == defaultLang && hideDefaultLang ? '/' : `/${lang}`}>
                        <img
                          alt={label}
                          title={label}
                          fetchpriority="high"
                          decoding="async"
                          class="mr-1 inline h-[1lh] w-4 max-w-none"
                          src={`${flags[lang as keyof typeof languages].src}`}
                        />
                        {label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </li>
        </ul>
      </div>
      <a href="#" class="btn btn-ghost hidden text-xl md:flex">Notifycal</a>
    </div>
    <!-- Center menu, hidden for small screens -->
    <div class="navbar-center hidden md:flex">
      <ul class="menu menu-horizontal [&>li>a:active]:!bg-primary px-1">
        <li>
          <a href="#faq">{t('nav.faq')}</a>
        </li>
        <li>
          <a href="#pricing">{t('nav.pricing')}</a>
        </li>
        <li>
          <details>
            <summary class="active:!bg-primary">
              <img
                alt={`${languages[lang]}`}
                title={`${languages[lang]}`}
                fetchpriority="high"
                decoding="async"
                class="mr-1 inline h-[1lh] w-4 max-w-none"
                src={flags[lang].src}
              />
            </summary>
            <ul class="[&>li>a:active]:!bg-primary p-2">
              {
                Object.entries(languages).map(([lang, label]) => (
                  <li>
                    <a href={lang == defaultLang && hideDefaultLang ? '/' : `/${lang}`}>
                      <img
                        alt={`${label}`}
                        title={`${label}`}
                        fetchpriority="high"
                        decoding="async"
                        class="mr-1 inline h-[1lh] w-4 max-w-none"
                        src={flags[lang as keyof typeof languages].src}
                      />
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
      </ul>
    </div>
    <!-- Logo in the middle only for small screens -->
    <div class="navbar-center flex md:hidden">
      <a href="#" class="btn btn-ghost text-xl">Notifycal</a>
    </div>
    <div class="navbar-end">
      <GoogleAccount />
    </div>
  </div>
</header>
