---

<svg
  xmlns="http://www.w3.org/2000/svg"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  id="animated-bg"
  style="margin: auto; background: var(--hero-svg-bg); display: block; z-index: 1; position: relative; shape-rendering: auto;"
  width="1000"
  height="1000"
  preserveAspectRatio="xMidYMid"
  viewBox="0 0 1000 1000"
>
  <defs>
    <radialGradient id="BoxGradient">
      <stop offset="0%" stop-color="var(--hero-svg-gradient-color-start)"></stop>
      <stop offset="40%" stop-color="var(--hero-svg-gradient-color-mid)"></stop>
      <stop offset="100%" stop-color="var(--hero-svg-gradient-color-end)"></stop>
    </radialGradient>
  </defs>
  <!-- Primary color referenced from daisyui theme -->
  <g id="square-group-bg" color="oklch(var(--p))">
    <!-- All rectangles will be rendered here -->
  </g>
  <rect width="100%" height="100%" fill="url(#BoxGradient)"></rect>
</svg>

<style>
  :root {
    /* check browser compatibility */
    --hero-svg-bg: rgb(221, 221, 221);

    --hero-svg-gradient-color-start: rgba(255, 255, 255, 0);
    --hero-svg-gradient-color-mid: rgba(255, 255, 255, 0.25);
    --hero-svg-gradient-color-end: rgba(255, 255, 255, 0.9);

    --hero-svg-rect-animation-fill-start: currentColor;
    --hero-svg-rect-animation-fill-mid: rgba(255, 255, 255, 1);
    --hero-svg-rect-animation-fill-end: rgba(255, 255, 255, 0);
  }
</style>

<script>
  type SvgInHTML = HTMLElement & SVGElement;

  const animationColorVariables = [
    '--hero-svg-rect-animation-fill-start',
    '--hero-svg-rect-animation-fill-mid',
    '--hero-svg-rect-animation-fill-end'
  ];

  const animationValuesBuilt = animationColorVariables
    .map((cssColorVar) => {
      return getComputedStyle(document.body).getPropertyValue(cssColorVar);
    })
    .join(';');

  function getRandom(min: number, max: number) {
    return -Math.random() * (max - min) + min;
  }

  function animateSquare(squareEl: SVGRectElement) {
    const animationAttrs: Record<string, string> = {
      attributeName: 'fill',
      repeatCount: 'indefinite',
      values: animationValuesBuilt,
      dur: '33.3s',
      begin: `${getRandom(0, 30)}s`,
      keytimes: '0;0.75;1'
    };
    const animationEl = document.createElementNS('http://www.w3.org/2000/svg', 'animate');

    Object.keys(animationAttrs).forEach((attribute: string) => {
      animationEl.setAttribute(attribute, animationAttrs[attribute]);
    });

    squareEl.appendChild(animationEl);
  }

  function generateSquares(
    svgContainerEl: SVGGElement,
    containerW: number,
    containerH: number,
    rectW: number,
    rectH: number,
    gapW: number,
    gapH: number
  ) {
    const squaresInX = Math.ceil((containerW + gapW) / (rectW + gapW));
    const squaresInY = Math.ceil((containerH + gapH) / (rectH + gapH));

    let currentSquareEl: SVGRectElement;
    const squareAttrs: Record<string, number | string> = {
      width: rectW,
      height: rectH,
      rx: 10,
      ry: 10,
      class: 'drop-shadow' // this is a tailwind class
    };

    const remainingWidth = containerW - squaresInX * (rectW + gapW);
    const initialXOffset = remainingWidth / 2;
    const initialYOffset = -(rectH / 2);

    // Calculate all rectangles first, then redraw
    let allChildren = [];

    for (let y = 0; y < squaresInY; y++) {
      for (let x = 0; x < squaresInX; x++) {
        // skip 60% of the squares, randomly
        if (Math.random() < 0.6) {
          currentSquareEl = document.createElementNS('http://www.w3.org/2000/svg', 'rect');

          // Add position to existing attributes
          const allAttrs: Record<string, number | string> = {
            ...squareAttrs,
            x: initialXOffset + x * (rectW + gapW),
            y: initialYOffset + y * (rectH + gapH)
          };

          // Set all attributes in the object
          Object.keys(allAttrs).forEach((attribute: string) => {
            currentSquareEl.setAttribute(attribute, String(allAttrs[attribute]));
          });

          // Create animation
          animateSquare(currentSquareEl);

          // Add square to list of rectangles
          allChildren.push(currentSquareEl);
        }
      }
    }

    // Replace all rectangles with list
    svgContainerEl.replaceChildren(...allChildren);
  }

  function drawIt() {
    const svgBgEl = document.getElementById('animated-bg') as SvgInHTML;
    const svgRectGroup = document.getElementById('square-group-bg') as unknown as SVGGElement;
    const containerW = window.innerWidth || document.documentElement.clientWidth || document.body.clientWidth;
    const containerH = window.innerHeight || document.documentElement.clientHeight || document.body.clientHeight;

    const numberSquaresX = containerW > 1024 ? 10 : 7;

    const rectW = Math.floor(containerW / numberSquaresX);
    const rectH = Math.floor(rectW / 1.6); // Keep the same aspect ratio
    const gapW = 20;
    const gapH = 20;

    // Set SVG dimensions and viewbox to container dimensions
    svgBgEl.setAttribute('height', String(containerH));
    svgBgEl.setAttribute('width', String(containerW));
    svgBgEl.setAttribute('viewBox', `0 0 ${containerW} ${containerH}`);

    generateSquares(svgRectGroup, containerW, containerH, rectW, rectH, gapW, gapH);
  }

  window.onresize = drawIt;
  drawIt();
</script>
