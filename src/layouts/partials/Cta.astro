---
import config from '@/config/config.json';

const {
  callToAction: {
    title,
    description,
    button: { label, link }
  }
} = config;
---

<section>
  <div class="bg-gradient justify-center">
    <div class="container">
      <div class="px-10 py-20 text-center lg:text-left">
        <div class="flex flex-col lg:flex-row [&>div]:flex-1 [&>div]:px-3">
          <div class="flex flex-col">
            <h1 class="text-white">{title}</h1>
            <a class="btn btn-white mt-8 self-center" href={link}>{label}</a>
          </div>
          <div class="mt-8 lg:mt-0">
            <p class="text-white">
              {description}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
