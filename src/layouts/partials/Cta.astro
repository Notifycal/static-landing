---
import { getCollectionEntryByLang, getLangFromUrl } from '@/lib/i18n';

const lang = getLangFromUrl(Astro.url);
const {
  data: { ctaTitle, ctaDescription, ctaButtonLabel }
} = await getCollectionEntryByLang('site', lang);
---

<section>
  <div class="bg-gradient justify-center">
    <div class="container">
      <div class="px-10 py-20 text-center lg:text-left">
        <div class="flex flex-col lg:flex-row [&>div]:flex-1 [&>div]:px-3">
          <div class="flex flex-col">
            <h1 class="text-white">{ctaTitle}</h1>
            <a id="cta-button" class="btn btn-white mt-8 self-center lg:self-start">{ctaButtonLabel}</a>
          </div>
          <div class="mt-8 lg:mt-0">
            <p class="text-white">
              {ctaDescription}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    function onServiceConfigReady(callback) {
      window.addEventListener('serviceConfigReady', function (event) {
        const config = event.detail;
        if (config && config.FRONTEND_URL) {
          callback(config.FRONTEND_URL, config);
        }
      });
    }
    onServiceConfigReady((frontendUrl) => {
      const ctaButton = document.getElementById('cta-button');
      if (ctaButton && frontendUrl) {
        ctaButton.href = frontendUrl;
      }
    });
  </script>
</section>
