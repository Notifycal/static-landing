---
import config from '@/config/config.json';

const {
  callToAction: {
    title,
    description,
    button: { label, link }
  }
} = config;
---

<section>
  <div class="bg-gradient row justify-center px-[30px] pt-16 pb-[75px]">
    <div class="container">
      <div class="py-20 lg:col-11 xl:py-[80px]">
        <div class="row">
          <div class="flex flex-col lg:col-7">
            <h2 class="h1 text-white">{title}</h2>
            <a class="btn btn-white mt-8 self-center" href={link}>{label}</a>
          </div>
          <div class="mt-8 lg:col-5 lg:mt-0">
            <p class="text-white">
              {description}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
