---
import { getLangFromUrl } from '@/lib/i18n-const';
import LanguagePicker from './LanguagePicker.astro';

const { languageMobileLabel } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<LanguagePicker
  variant="mobile"
  languageMobileLabel={languageMobileLabel}
  currentLang={lang}
  currentUrl={Astro.url}
  className="mt-2 lg:hidden"
/>
