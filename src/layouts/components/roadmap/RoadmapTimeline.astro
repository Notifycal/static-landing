---
import FeatureCard from './FeatureCard.astro';

export interface Props {
  confirmedFeatures: Array<{
    title: string;
    description: string;
    icon: string;
    status: 'confirmed' | 'in-development' | 'planning';
  }>;
  potentialFeatures: Array<{
    title: string;
    description: string;
    icon: string;
  }>;
}

const { confirmedFeatures, potentialFeatures } = Astro.props;
---

<section class="section bg-gradient-to-b from-gray-50 to-white">
  <div class="container">
    <!-- Confirmed Features Timeline -->
    <div class="mb-16">
      <div class="mb-12 text-center">
        <h2 class="text-h2 mb-4">Confirmed upcoming stops</h2>
        <p class="text-text text-lg">These features are on our roadmap and will arrive soon</p>
      </div>

      <div class="relative">
        <!-- Metro Line -->
        <div class="bg-primary absolute left-1/2 z-0 hidden h-full w-1 -translate-x-1/2 transform md:block"></div>

        <!-- Timeline Items -->
        <div class="space-y-12">
          {
            confirmedFeatures.map((feature, index) => (
              <div class={`flex items-center ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
                <div class="w-full md:w-5/12">
                  <FeatureCard feature={feature} isConfirmed={true} />
                </div>

                <div class="relative z-10 hidden w-2/12 justify-center md:flex">
                  <div class="bg-primary flex h-12 w-12 items-center justify-center rounded-full text-xl font-bold text-white shadow-lg">
                    {index + 1}
                  </div>
                </div>

                <div class="hidden w-5/12 md:block" />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Potential Features -->
    <div class="mb-16">
      <div class="mb-12 text-center">
        <h2 class="text-h2 mb-4">Possible future destinations</h2>
        <p class="text-text text-lg">Ideas we're considering based on our users' needs</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {potentialFeatures.map((feature) => <FeatureCard feature={feature} isConfirmed={false} />)}
      </div>
    </div>
  </div>
</section>
