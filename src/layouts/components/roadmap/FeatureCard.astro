---
import { markdownify } from '@/lib/utils/textConverter';

export interface Props {
  feature: {
    title: string;
    description: string;
    icon: string;
    status?: 'confirmed' | 'in-development' | 'planning';
  };
  isConfirmed?: boolean;
}

const { feature, isConfirmed = false } = Astro.props;

const getStatusBadge = (status?: string) => {
  switch (status) {
    case 'confirmed':
      return { text: 'Confirmed', class: 'bg-green-100 text-green-800' };
    case 'in-development':
      return { text: 'In development', class: 'bg-blue-100 text-blue-800' };
    case 'planning':
      return { text: 'Planning', class: 'bg-yellow-100 text-yellow-800' };
    default:
      return null;
  }
};

const statusBadge = getStatusBadge(feature.status);
---

<div class={`rounded-lg p-6 shadow-lg transition-all duration-300 hover:shadow-xl ${isConfirmed ? 'bg-white border-2 border-primary' : 'bg-gray-50 border border-gray-200'}`}>
  <div class="flex items-start gap-4">
    <div class="flex-shrink-0">
      <span class="text-4xl">{feature.icon}</span>
    </div>
    <div class="flex-1">
      <div class="flex items-start justify-between mb-3">
        <h3 class="text-xl font-semibold text-dark" set:html={markdownify(feature.title)} />
        {statusBadge && (
          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusBadge.class}`}>
            {statusBadge.text}
          </span>
        )}
      </div>
      <p class="text-text leading-relaxed" set:html={markdownify(feature.description)} />
      {!isConfirmed && (
        <div class="mt-4 text-sm text-gray-500 italic">
          Feature under consideration
        </div>
      )}
    </div>
  </div>
</div>