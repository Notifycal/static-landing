---
import { getCollectionEntryByLang } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';
import { markdownify } from '@/lib/utils/textConverter';

export interface Props {
  feature: {
    title: string;
    description: string;
    icon: string;
    status?: 'confirmed' | 'in-development' | 'planning';
  };
  isConfirmed?: boolean;
}

const { feature, isConfirmed = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const {
  data: { confirmed, inDevelopment, planning, featureUnderConsideration }
} = await getCollectionEntryByLang('roadmap', lang);

const getStatusBadge: Record<'confirmed' | 'in-development' | 'planning', { text: string; class: string }> = {
  confirmed: { text: confirmed, class: 'bg-green-100 text-green-800' },
  'in-development': { text: inDevelopment, class: 'bg-blue-100 text-blue-800' },
  planning: { text: planning, class: 'bg-yellow-100 text-yellow-800' }
};

const statusBadge = feature.status ? getStatusBadge[feature.status] : null;
---

<div
  class={`rounded-lg p-6 shadow-lg transition-all duration-300 hover:shadow-xl ${isConfirmed ? 'bg-white border-2 border-primary' : 'bg-gray-50 border border-gray-200'}`}
>
  <div class="flex items-start gap-4">
    <div class="flex-shrink-0">
      <span class="text-4xl">{feature.icon}</span>
    </div>
    <div class="flex-1">
      <div class="mb-3 flex items-start justify-between">
        <h3 class="text-dark text-xl font-semibold" set:html={markdownify(feature.title)} />
        {
          statusBadge && (
            <span
              class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${statusBadge.class}`}
            >
              {statusBadge.text}
            </span>
          )
        }
      </div>
      <p class="text-dark leading-relaxed" set:html={markdownify(feature.description)} />
      {!isConfirmed && <div class="mt-4 text-sm text-gray-500 italic">{featureUnderConsideration}</div>}
    </div>
  </div>
</div>
