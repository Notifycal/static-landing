---
import { markdownify } from '@/lib/utils/textConverter';

export interface Props {
  votingCTA: {
    title: string;
    description: string;
    buttonText: string;
  };
}

const { votingCTA } = Astro.props;
---

<section class="section bg-gradient">
  <div class="container">
    <div class="row justify-center">
      <div class="text-center lg:col-8">
        <h2 set:html={markdownify(votingCTA.title)} class="text-h2 mb-6 text-white" />
        <p set:html={markdownify(votingCTA.description)} class="mb-8 text-lg leading-relaxed text-white" />
        <a
          id="voting-cta-button"
          class="btn btn-cta btn-accent2 inline-flex transform items-center"

        >
          {votingCTA.buttonText}
          <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
  <script is:inline>
    function setupVotingCtaButton() {
      window.onServiceConfigReady((frontendUrl) => {
        const ctaButton = document.getElementById('voting-cta-button');
        if (ctaButton && frontendUrl) {
          ctaButton.href = encodeURI(`${frontendUrl}/#/?redirect=/feedback`);
        }
      }, 'FRONTEND_URL');
    }

    document.addEventListener('astro:page-load', setupVotingCtaButton);
    setupVotingCtaButton();
  </script>
</section>
