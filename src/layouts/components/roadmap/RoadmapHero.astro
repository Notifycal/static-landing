---
import { markdownify } from '@/lib/utils/textConverter';

export interface Props {
  intro: {
    title: string;
    description: string;
  };
}

const { intro } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="row justify-center">
      <div class="text-center lg:col-8">
        <h1 set:html={markdownify(intro.title)} class="text-h1 mb-6" />
        <p set:html={markdownify(intro.description)} class="text-dark mb-8 text-lg" />
      </div>
    </div>
  </div>
</section>
