---
import FaqComponent from '@/layouts/react/Faq';
import type { CollectionEntry } from 'astro:content';

type Props = {
  faq: CollectionEntry<'home'>['data']['faq'];
};

const { faq } = Astro.props;
---

<section class="section faqs" id="faq" data-scroll-mt>
  <div class="container max-w-[1230px]">
    <FaqComponent client:load faqData={faq} />
  </div>
</section>
