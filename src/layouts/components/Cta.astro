---
const {
  cta: { title, description, buttonLabel }
} = Astro.props;
---

<section>
  <div class="bg-gradient justify-center">
    <div class="container">
      <div class="px-10 py-20 text-center lg:text-left">
        <div class="flex flex-col lg:flex-row [&>div]:flex-1 [&>div]:px-3">
          <div class="flex flex-col">
            <h1 class="text-white">{title}</h1>
            <a id="cta-button" class="btn btn-white mt-8 self-center lg:self-start">{buttonLabel}</a>
          </div>
          <div class="mt-8 lg:mt-0">
            <p class="text-white text-lg">
              {description}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    function setupCtaButton() {
      window.onServiceConfigReady((frontendUrl) => {
        const ctaButton = document.getElementById('cta-button');
        if (ctaButton && frontendUrl) {
          ctaButton.href = frontendUrl;
        }
      }, 'FRONTEND_URL');
    }

    document.addEventListener('astro:page-load', setupCtaButton);
    setupCtaButton();
  </script>
</section>
