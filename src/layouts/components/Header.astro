---
import Logo from '@/components/Logo.astro';
import { getCollectionEntryByLang, useTranslatedPath } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';
import clsx from 'clsx';
import LanguagePickerMobile from './LanguagePickerMobile.astro';
import LanguagePickerDesktop from './LanguagePickerDesktop.astro';
import Dropdown from './Dropdown.astro';

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink extends ChildNavigationLink {
  children?: ChildNavigationLink[];
}

const lang = getLangFromUrl(Astro.url);
const {
  data: { signIn, languageMobileLabel }
} = await getCollectionEntryByLang('header', lang);
const navigation = await getCollectionEntryByLang('navigation', lang);
const translatePath = useTranslatedPath(lang);

const { main }: { main: NavigationLink[] } = navigation.data;
const { pathname } = Astro.url;

function isActivePath(menuUrl: string): boolean {
  const expectedPath = translatePath(menuUrl);
  return pathname === expectedPath || pathname === `${expectedPath}/`;
}
---

<header class="header bg-secondary" id="siteHeader">
  <nav class="navbar container">
    <!-- logo -->
    <div class="order-0">
      <Logo />
    </div>
    <!-- navbar toggler -->
    <input id="nav-toggle" type="checkbox" class="hidden" />
    <label
      id="show-button"
      for="nav-toggle"
      class="text-primary order-2 flex cursor-pointer items-center md:order-1 md:ml-auto lg:hidden"
    >
      <svg class="h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Open</title>
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
    </label>
    <label
      id="hide-button"
      for="nav-toggle"
      class="text-primary order-2 hidden cursor-pointer items-center md:order-1 md:ml-auto"
    >
      <svg class="h-6 fill-current" viewBox="0 0 20 20">
        <title>Menu Close</title>
        <polygon points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2" transform="rotate(45 10 10)"
        ></polygon>
      </svg>
    </label>

    <!-- /navbar toggler -->
    <ul id="nav-menu" class="navbar-nav order-3 hidden w-full lg:order-1 lg:flex lg:w-auto">
      {
        main.map((menu) => (
          <>
            {menu.children && menu.children.length > 0 ? (
              <Dropdown
                width="w-44"
                className={clsx({
                  active: menu.children?.some(({ url }) => isActivePath(url)) ?? false
                })}
                items={menu.children.map((child) => ({
                  content: child.name,
                  href: translatePath(child.url),
                  isActive: isActivePath(child.url)
                }))}
              >
                <Fragment slot="trigger">{menu.name}</Fragment>
              </Dropdown>
            ) : (
              <li class="nav-item">
                <a
                  href={translatePath(menu.url)}
                  class={clsx({
                    'nav-link inline-block lg:block': true,
                    'active pointer-events-none': isActivePath(menu.url)
                  })}
                >
                  {menu.name}
                </a>
              </li>
            )}
          </>
        ))
      }
      <li class="nav-item lg:hidden">
        <LanguagePickerMobile languageMobileLabel={languageMobileLabel} />
      </li>
      <li class="nav-item mt-3 lg:hidden">
        <a id="signin-button-md" class="btn btn-primary btn-sm border-border">{signIn}</a>
      </li>
    </ul>
    <div class="order-1 ml-auto flex items-center space-x-3 md:order-2 md:ml-0">
      <LanguagePickerDesktop />
      <a id="signin-button-lg" class="btn btn-primary btn-sm hidden lg:block">{signIn}</a>
    </div>
  </nav>
</header>

<script is:inline>
  function setupSignInButtons() {
    window.onServiceConfigReady((frontendUrl) => {
      const viewportSizes = ['md', 'lg'];
      viewportSizes.forEach((size) => {
        const signInButton = document.getElementById(`signin-button-${size}`);
        if (signInButton && frontendUrl) {
          signInButton.href = frontendUrl;
        }
      });
    }, 'FRONTEND_URL');
  }
  setupSignInButtons();

  document.addEventListener('astro:page-load', () => {
    setupSignInButtons();

    // Sticky header functionality
    const header = document.querySelector('.header');

    if (header) {
      const toggle = () => {
        if (window.scrollY > 0) {
          header.classList.add('header-sticky');
        } else {
          header.classList.remove('header-sticky');
        }
      };

      toggle();
      window.addEventListener('scroll', toggle);
      window.addEventListener('pageshow', toggle);
    }
  });
</script>
