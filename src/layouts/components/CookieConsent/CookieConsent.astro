---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import './style.css';
---

<button type="button" data-cc="show-preferencesModal" hidden>Show preferences modal</button>

<script>
  import { run } from 'vanilla-cookieconsent';
  import { config } from './CookieConsentConfig';

  document.body.classList.add('cc--theme');
  run(config());
</script>
