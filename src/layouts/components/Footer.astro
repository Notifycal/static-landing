---
import Logo from '@/components/Logo.astro';
import Social from '@/components/Social.astro';
import social from '@/config/social.json';
import CookieConsent from '@/layouts/components/CookieConsent.astro';
import { getCollectionEntryByLang } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';
import { markdownify } from '@/lib/utils/textConverter';

const lang = getLangFromUrl(Astro.url);
const {
  data: { description, copyright, socialsTitle, quickLinksTitle, locationContactTitle, location, feedback }
} = await getCollectionEntryByLang('footer', lang);
const navigation = await getCollectionEntryByLang('navigation', lang);
---

<footer class="footer bg-secondary-700 text-text-light">
  <div class="container">
    <div class="gx-5 row pt-4 pb-10 md:pt-12">
      <div class="col-12 mt-12 text-center md:col-6 md:text-left lg:col-3">
        <div class="flex justify-center md:justify-start">
          <Logo />
        </div>
        <p class="mt-6">
          {description}
        </p>
      </div>
      <div class="col-12 mt-12 text-center md:col-6 md:text-left lg:col-3">
        <h6>{socialsTitle}</h6>
        <div class="flex justify-center md:justify-start">
          <Social source={social} className="social-icons mt-4 lg:mt-6" />
        </div>
      </div>
      <div class="col-12 mt-12 text-center md:col-6 md:text-left lg:col-3">
        <h6>{quickLinksTitle}</h6>
        <ul>
          {
            navigation.data.footer.map((item, i) => (
              <li class={navigation.data.footer.length - 1 === i ? 'mb-0' : 'mb-4'}>
                {item.type === 'anchor' ? (
                  <CookieConsent buttonSettingsText={item.name} />
                ) : item.type === 'frontend' ? (
                  <a
                    id={`frontend-link-${i}`}
                    href={item.url}
                    data-original-url={item.url}
                    {...(item.target && { target: item.target })}
                  >
                    {item.name}
                  </a>
                ) : (
                  <a href={item.url} {...(item.target && { target: item.target })}>
                    {item.name}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="col-12 mt-12 text-center md:col-6 md:text-left lg:col-3">
        <h6>{locationContactTitle}</h6>
        <ul>
          <li class="mb-2">
            <a href="https://maps.app.goo.gl/ZSm6CzY6wzDhJn9BA" target="_blank">{location}</a>
          </li>
          <li class="mb-2">
            <a id="feedback-link" class="hover:text-primary mb-2">{feedback}</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <div class="container max-w-[1440px]">
    <div class="footer-copyright border-border mx-auto border-t pt-7 pb-10 text-center">
      <p set:html={'© ' + new Date().getFullYear() + ' ' + markdownify(copyright)} />
    </div>
  </div>
</footer>
<script is:inline>
  function setupFrontendLinks() {
    window.onServiceConfigReady((frontendUrl) => {
      if (!frontendUrl) return;

      const feedbackLink = document.getElementById('feedback-link');
      if (feedbackLink) {
        feedbackLink.href = encodeURI(`${frontendUrl}/#/?redirect=/feedback`);
      }
      const frontendLinks = document.querySelectorAll('[id^="frontend-link-"]');
      frontendLinks.forEach((link) => {
        const originalUrl = link.getAttribute('data-original-url');
        link.href = `${frontendUrl}${originalUrl}`;
      });
    }, 'FRONTEND_URL');
  }

  document.addEventListener('astro:page-load', setupFrontendLinks);
  setupFrontendLinks();
</script>
