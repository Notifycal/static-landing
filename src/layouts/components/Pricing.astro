---
import { getLangFromUrl } from '@/lib/i18n-const';
import { TierSelection } from '../function-components/TierSelection';

const { pricing } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<section class="section pricing">
  <div class="container">
    <div class="row justify-between">
      <div class="lg:col-6">
        <h2>{pricing.title}</h2>
      </div>
      <div class="lg:col-4">
        <p>
          {pricing.description}
        </p>
      </div>
    </div>
    <TierSelection client:visible locale={lang} />
  </div>
</section>
