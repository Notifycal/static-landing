---
import type { CollectionEntry } from 'astro:content';
type HeroEntry = CollectionEntry<'home'>['data']['hero'];

import { markdownify } from '@/lib/utils/textConverter';
import { TbSquareRoundedChevronDownFilled } from 'react-icons/tb';
import clsx from 'clsx';

const { hero } = Astro.props as { hero: HeroEntry };
const { title, subtitles, mainButton, secondaryButton, content, poweredBy, sellingPoints } = hero;

// TODO:
// - Verify language text "length". ie: buttons,
// - Decide on sub-sub-title (adjust width)
// - min-h for video?
// - review lighthouse scores
---

<section
  class="relative flex min-h-[calc(100dvh-var(--header-height))] w-full flex-col items-center overflow-hidden"
  id="start"
  data-scroll-mt
>
  <picture>
    <source
      srcset="
        /images/hero-768.webp 768w,
        /images/hero-1280.webp 1280w,
        /images/hero-1920.webp 1920w,
      "
      sizes="(max-width: 768px) 100vw,
           (max-width: 1280px) 100vw,
           1920px"
      type="image/webp"
    />
    <img
      id="heroVideoFallback"
      src="/images/hero-1920.webp"
      alt=""
      class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity duration-1000 ease-in-out"
    />
  </picture>

  <video
    id="heroVideo"
    class="absolute top-0 left-0 z-[-1] h-full w-full object-cover"
    autoplay
    muted
    playsinline
    preload="none"
  >
    <source src="/video/hero.mp4" type="video/mp4" />
  </video>

  <div class="absolute inset-0 z-1 bg-[rgba(0,0,0,0.45)] bg-blend-multiply"></div>

  <div class="text-primary-50 relative z-10 container flex h-full grow flex-col">
    <div class="hero-content flex w-full flex-1 flex-col items-center justify-center pt-8 text-center">
      <h1 class="text-secondary-200 text-center text-5xl font-bold xl:text-6xl">
        <span class="text-4xl xl:text-5xl">{title}</span><br />
        <div id="dynamicSubtitle" class="relative w-full pb-2 md:pb-8">
          <p class="invisible">
            {subtitles.reduce((a, b) => (b.length > a.length ? b : a))}
          </p>
          {
            subtitles.map((subtitle, index) => (
              <p
                class={clsx(
                  'text-primary-500 absolute inset-0 transition-opacity duration-700 ease-in-out',
                  index === 0 ? 'opacity-100' : 'opacity-0'
                )}
                data-subtitle={index}
              >
                {subtitle}
              </p>
            ))
          }
        </div>
      </h1>

      {content && <p class="ttext-md text-center md:text-xl" set:html={markdownify(content)} />}

      <div class="mx-auto max-w-2xl">
        <div
          class="my-4 grid justify-center justify-items-start gap-0 sm:grid-cols-[max-content_max-content] sm:gap-2 md:my-6"
        >
          {
            sellingPoints.map((item) => (
              <div class="flex items-center">
                <svg
                  class="mr-3 size-5 flex-shrink-0 text-green-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-primary-50 text-left">{item}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mx-auto mb-8 flex w-full max-w-2xl flex-col justify-center gap-4 sm:flex-row sm:gap-12 xl:mt-8">
        {
          mainButton && mainButton.enable && (
            <div class="flex-1 text-center">
              <a class="btn btn-primary button-vibrate h-auto w-full" href={mainButton.link}>
                {mainButton.label}
              </a>
            </div>
          )
        }

        {
          secondaryButton && secondaryButton.enable && (
            <div class="flex-1 text-center">
              <a class="btn h-auto w-full border-1 border-white bg-transparent" href={secondaryButton.link}>
                {secondaryButton.label}
              </a>
            </div>
          )
        }
      </div>
      <div class="mb-4 flex items-center justify-center gap-4 py-2">
        <span class="text-secondary-200 text-lg">{poweredBy.title}</span>
        {
          poweredBy.powerers.map((power) => (
            <img
              src={power.image}
              alt={power.title}
              class="size-7 opacity-90 transition-opacity duration-200 hover:opacity-100"
            />
          ))
        }
      </div>
    </div>
    <div class="flex justify-center pb-6">
      <a
        href="#features"
        class="mt-2 size-12 animate-bounce text-white [animation-duration:3s] hover:[animation-duration:1s] md:mt-12 md:size-16"
      >
        <TbSquareRoundedChevronDownFilled size="100%" />
      </a>
    </div>
  </div>
</section>

<script>
  import { handleVideoFallback, handleVideoPause } from '@/lib/utils/heroVideo';

  document.addEventListener('astro:page-load', () => {
    const video = document.querySelector<HTMLVideoElement>('#heroVideo');
    const videoFallback = document.querySelector<HTMLImageElement>('#heroVideoFallback');

    if (!video) return;

    if (videoFallback) {
      handleVideoFallback(video, videoFallback);
    }

    handleVideoPause(video);
  });
</script>

<script>
  document.addEventListener('astro:page-load', () => {
    const subtitles = document.querySelectorAll<HTMLElement>('[data-subtitle]');
    let index = 0;

    setInterval(() => {
      const current = subtitles[index];
      index = (index + 1) % subtitles.length;
      const next = subtitles[index];

      current.style.opacity = '0';
      next.style.opacity = '1';
    }, 3000);
  });
</script>
