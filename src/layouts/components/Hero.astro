---
import { markdownify } from '@/lib/utils/textConverter';
import { Image } from 'astro:assets';
const { hero } = Astro.props;
const { title, button, content, poweredBy } = hero;
---

<section class="section banner relative">
  <div class="container">
    <div class="row items-center">
      <div class="flex flex-col lg:col-6">
        <h1 class="banner-title" set:html={markdownify(title)} />
        <p class="mt-6 text-lg" set:html={markdownify(content)} />
        {
          button.enable && (
            <a class="btn btn-primary my-8 self-center" href={button.link}>
              {button.label}
            </a>
          )
        }
      </div>
      <div class="my-11 lg:col-6">
        <Image class="mx-auto w-full object-contain" alt="service" width={480} height={320} src="/images/hero.webp" />
        <section class="mt-8 flex flex-col">
          <h4 class="text-dark mb-4 ml-6 text-left">{poweredBy}</h4>
          <div class="ml-8 flex justify-center gap-10">
            <img
              src="/images/google-calendar-icon.svg"
              alt="Google Calendar"
              class="h-10 w-10 opacity-90 transition-opacity duration-200 hover:opacity-100"
            />
            <img
              src="/images/google-contacts-icon.svg"
              alt="Google Contacts"
              class="h-10 w-10 opacity-90 transition-opacity duration-200 hover:opacity-100"
            />
            <img
              src="/images/stripe-icon.svg"
              alt="Stripe"
              class="h-10 w-10 opacity-90 transition-opacity duration-200 hover:opacity-100"
            />
          </div>
        </section>
      </div>
    </div>
  </div>
</section>
