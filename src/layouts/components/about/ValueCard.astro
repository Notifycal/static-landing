---
import { markdownify } from '@/lib/utils/textConverter';

interface Props {
  value: {
    title: string;
    content: string;
  };
}

const { value } = Astro.props;
---

<div class="mb-8 md:col-6">
  <div class="values-card border-light h-full rounded-lg border bg-primary-50 p-6 transition-shadow hover:shadow-sm">
    <h3 class="text-text-dark mb-4 text-xl font-semibold">{value.title}</h3>
    <p class="text-dark leading-relaxed" set:html={markdownify(value.content)} />
  </div>
</div>
