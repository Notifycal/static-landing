---
import { markdownify } from '@/lib/utils/textConverter';
import ValueCard from './ValueCard.astro';

interface Props {
  values: {
    title: string;
    description: string;
    valuesList: Array<{
      title: string;
      content: string;
    }>;
  };
}

const { values } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="row justify-center">
      <div class="mb-16 text-center lg:col-8">
        <h2 class="mb-6">{values.title}</h2>
        <p class="text-text text-lg" set:html={markdownify(values.description)} />
      </div>
    </div>

    <div class="row">
      {values.valuesList.map((value) => (
        <ValueCard value={value} />
      ))}
    </div>
  </div>
</section>