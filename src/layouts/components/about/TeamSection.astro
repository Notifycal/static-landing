---
import { markdownify } from '@/lib/utils/textConverter';
import TeamMemberCard from './TeamMemberCard.astro';

interface Props {
  members: {
    title: string;
    description: string;
    memberList: Array<{
      name: string;
      field: string;
      image: string;
      bio: string;
      linkedin: string;
      github: string;
    }>;
  };
}

const { members } = Astro.props;
---

<section class="section bg-light">
  <div class="container">
    <div class="row justify-center">
      <div class="mb-16 text-center lg:col-8">
        <h2 class="mb-6">{members.title}</h2>
        <p class="text-text text-lg" set:html={markdownify(members.description)} />
      </div>
    </div>

    <div class="row justify-center">
      {members.memberList.map((member) => (
        <TeamMemberCard member={member} />
      ))}
    </div>
  </div>
</section>