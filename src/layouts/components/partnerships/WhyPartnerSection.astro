---
import { AiFillCheckCircle } from 'react-icons/ai';
import { IoFlash, IoTrendingUp, IoLayers } from 'react-icons/io5';

interface Props {
  whyPartner: {
    title: string;
    description: string;
    benefits: Array<{
      title: string;
      description: string;
      icon: string;
    }>;
  };
}

const { whyPartner } = Astro.props;

const iconMap: Record<string, typeof AiFillCheckCircle> = {
  'check-circle': AiFillCheckCircle,
  'zap': IoFlash,
  'trending-up': IoTrendingUp,
  'layers': IoLayers
};
---

<section class="section bg-gradient">
  <div class="container">
    <div class="row justify-center">
      <div class="lg:col-8">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-white">{whyPartner.title}</h2>
          <p class="text-lg text-white/90">{whyPartner.description}</p>
        </div>
      </div>
    </div>
    <div class="row gy-4">
      {
        whyPartner.benefits.map((benefit) => {
          const IconComponent = iconMap[benefit.icon] || AiFillCheckCircle;
          return (
            <div class="lg:col-6">
              <div class="h-full rounded-lg bg-white p-8 shadow-sm">
                <IconComponent className="mb-4 size-12 text-primary" />
                <h3 class="mb-3 text-xl">{benefit.title}</h3>
                <p class="text-dark/70">{benefit.description}</p>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
