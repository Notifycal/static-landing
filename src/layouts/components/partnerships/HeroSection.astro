---
import { markdownify } from '@/lib/utils/textConverter';

interface Props {
  hero: {
    title: string;
    subtitle: string;
    description: string;
  };
}

const { hero } = Astro.props;
---

<section class="section pt-28">
  <div class="container">
    <div class="row justify-center">
      <div class="lg:col-10">
        <div class="text-center">
          <h1 class="mb-4">{hero.title}</h1>
          <h2 class="text-dark/80 mb-6 text-2xl font-normal">{hero.subtitle}</h2>
          <p class="text-dark/70 mx-auto max-w-3xl text-lg" set:html={markdownify(hero.description)} />
        </div>
      </div>
    </div>
  </div>
</section>
