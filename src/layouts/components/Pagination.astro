---
import { useTranslatedPath } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';
import PaginationButton from './PaginationButton.astro';

const { section, currentPage, totalPages, blogIndex } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const indexPageLink = currentPage === 2;
const hasPrevPage = currentPage > 1;
const hasNextPage = totalPages > currentPage;

const pageList = Array.from({ length: totalPages }, (_, i) => i + 1);

const prevHref = indexPageLink ? translatePath(`/${section}/`) : translatePath(`/${section}/page/${currentPage - 1}/`);

const nextHref = translatePath(`/${section}/page/${currentPage + 1}/`);

const getPageHref = (page: number) =>
  page === 1 ? translatePath(`/${section}/`) : translatePath(`/${section}/page/${page}/`);
---

{
  totalPages > 1 && (
    <nav class="mt-14 mb-4 flex items-center justify-center" aria-label="Pagination">
      <PaginationButton
        href={hasPrevPage ? prevHref : undefined}
        disabled={!hasPrevPage}
        text={blogIndex?.data.previousText}
        direction="prev"
      />

      {/* page index */}
      {pageList.map((pagination) =>
        pagination === currentPage ? (
          <span
            aria-current="page"
            class={`bg-primary mx-1 flex h-10 w-10 items-center justify-center rounded-full text-white md:h-12 md:w-12`}
          >
            {pagination}
          </span>
        ) : (
          <a
            href={getPageHref(pagination)}
            aria-current="page"
            class={`text-text-dark hover:bg-accent1-500 mx-1 flex h-10 w-10 items-center justify-center rounded-full border no-underline hover:text-white md:h-12 md:w-12`}
          >
            {pagination}
          </a>
        )
      )}

      <PaginationButton
        href={hasNextPage ? nextHref : undefined}
        disabled={!hasNextPage}
        text={blogIndex?.data.nextText}
        direction="next"
      />
    </nav>
  )
}
