---
import { buildLocalizedUrl } from '@/lib/i18n';
import { getPathWithoutLang, languages } from '@/lib/i18n-const';
import caFlag from '@notifycal/shared/assets/icons/lang/ca.svg';
import esFlag from '@notifycal/shared/assets/icons/lang/es.svg';
import enFlag from '@notifycal/shared/assets/icons/lang/gb.svg';
import type { LanguageCode } from '@notifycal/shared/types';
import type { ImageMetadata } from 'astro';
import clsx from 'clsx';
import Dropdown from './Dropdown.astro';

const flags: Record<keyof typeof languages, ImageMetadata> = {
  en: enFlag,
  es: esFlag,
  ca: caFlag
};

export interface Props {
  variant: 'mobile' | 'desktop';
  languageMobileLabel?: string;
  currentLang: keyof typeof languages;
  currentUrl?: URL;
  className?: string;
}

const { variant, languageMobileLabel, currentLang, currentUrl, className = '' } = Astro.props;
const currentPath = currentUrl ? getPathWithoutLang(currentUrl) : '/';
---

<Dropdown className={className}>
  <Fragment slot="trigger">
    {
      variant === 'desktop' && currentLang && (
        <img
          alt={languages[currentLang]}
          title={languages[currentLang]}
          fetchpriority="high"
          decoding="async"
          class="mr-1 inline aspect-square h-6 w-6 max-w-none"
          src={flags[currentLang].src}
        />
      )
    }
    {variant === 'mobile' && <span class="text-white">{languageMobileLabel}</span>}
  </Fragment>
  <Fragment slot="items">
    {
      Object.entries(languages).map(([lang, label]) => {
        const href = buildLocalizedUrl(currentPath, lang as LanguageCode);
        return (
          <li class="nav-dropdown-item">
            <a
              href={href}
              class={clsx({
                'dropdown-item': true,
                active: lang === currentLang
              })}
            >
              <img
                alt={label}
                title={label}
                fetchpriority="high"
                decoding="async"
                class="inline-block h-4 w-4 flex-shrink-0"
                src={flags[lang as keyof typeof languages].src}
              />
              <span>{label}</span>
            </a>
          </li>
        );
      })
    }
  </Fragment>
</Dropdown>
