---
export interface DropdownItem {
  content: string | astroHTML.JSX.Element;
  href: string;
  isActive?: boolean;
}

export interface Props {
  width?: string;
  className?: string;
  triggerIcon?: boolean;
  items?: DropdownItem[];
}

const { className = '', triggerIcon = true, items = [] } = Astro.props;
---

<div class={`nav-item nav-dropdown dropdown-button relative cursor-pointer ${className}`}>
  <span class="nav-link inline-flex items-center">
    <slot name="trigger" />
    {
      triggerIcon && (
        <svg class="ml-1 h-4 w-4 fill-current" viewBox="0 0 20 20">
          <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
        </svg>
      )
    }
  </span>
  <ul
    class="nav-dropdown-list bg-secondary-500 relative left-1/2 z-10 mx-auto hidden min-w-max -translate-x-1/2 overflow-hidden rounded-lg border border-gray-200 px-2 py-2 shadow-lg duration-300 lg:absolute lg:bg-white"
  >
    {
      items && items.length > 0 ? (
        items.map((item) => (
          <li class="nav-dropdown-item block">
            <a href={item.href} class={`nav-link dropdown-item ${item.isActive ? 'active' : ''}`}>
              {typeof item.content === 'string' ? <span>{item.content}</span> : item.content}
            </a>
          </li>
        ))
      ) : (
        <slot name="items" />
      )
    }
  </ul>
</div>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.dropdown-button').forEach((button) => {
      button.addEventListener('click', (e) => {
        if (e.target.closest('.dropdown-item')) {
          const dropdown = e.currentTarget.querySelector('.nav-dropdown-list');
          if (dropdown) {
            dropdown.classList.add('hidden');
          }
          return;
        }

        e.preventDefault();

        const dropdown = e.currentTarget.querySelector('.nav-dropdown-list');
        if (!dropdown) return;

        const isCurrentlyOpen = !dropdown.classList.contains('hidden');

        // Close all other dropdowns first
        document.querySelectorAll('.nav-dropdown-list').forEach((otherDropdown) => {
          otherDropdown.classList.add('hidden');
        });

        if (!isCurrentlyOpen) {
          dropdown.classList.remove('hidden');
        }
      });
    });

    // Close all dropdowns when clicking outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.dropdown-button')) {
        document.querySelectorAll('.nav-dropdown-list').forEach((dropdown) => {
          dropdown.classList.add('hidden');
        });
      }
    });
  });
</script>
