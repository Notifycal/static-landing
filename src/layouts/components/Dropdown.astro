---
export interface DropdownItem {
  content: string | astroHTML.JSX.Element;
  href: string;
  isActive?: boolean;
}

export interface Props {
  width?: string;
  className?: string;
  triggerIcon?: boolean;
  items?: DropdownItem[];
}

const { width = 'w-48', className = '', triggerIcon = true, items = [] } = Astro.props;
---

<div class={`nav-item nav-dropdown group dropdown-button relative cursor-pointer ${className}`}>
  <span class="nav-link inline-flex items-center">
    <slot name="trigger" />
    {
      triggerIcon && (
        <svg class="ml-1 h-4 w-4 fill-current" viewBox="0 0 20 20">
          <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
        </svg>
      )
    }
  </span>
  <ul
    class={`nav-dropdown-list z-10 mx-auto mt-2 mb-2 hidden rounded-lg border border-gray-200 bg-secondary-500 lg:bg-white px-0 py-2 shadow-lg duration-300 lg:invisible lg:absolute lg:block lg:h-auto ${width} lg:opacity-0 lg:group-hover:visible lg:group-hover:opacity-100 overflow-hidden`}
  >
    {items && items.length > 0 ? (
      items.map((item) => (
        <li class="nav-dropdown-item block">
          <a
            href={item.href}
            class={`nav-link dropdown-item ${item.isActive ? 'active' : ''}`}
          >
            {item.content}
          </a>
        </li>
      ))
    ) : (
      <slot name="items" />
    )}
  </ul>
</div>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.dropdown-button').forEach((button) => {
      button.addEventListener('click', (e) => {
        const dropdown = e.currentTarget.querySelector('.nav-dropdown-list');
        if (dropdown) {
          dropdown.classList.toggle('hidden');
        }
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.dropdown-button')) {
        document.querySelectorAll('.nav-dropdown-list').forEach((dropdown) => {
          dropdown.classList.add('hidden');
        });
      }
    });
  });
</script>
