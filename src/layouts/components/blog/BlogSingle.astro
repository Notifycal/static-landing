---
import dateFormat from '@/lib/utils/dateFormat';
import readingTime from '@/lib/utils/readingTime';

import Breadcrumb from '@/layouts/components/Breadcrumb.astro';
import { translateCategory } from '@/lib/categoryTranslations';
import { getCollectionEntryByLang } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';
import { humanize, slugify } from '@/lib/utils/textConverter';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { FaRegCalendarAlt, FaRegClock, FaRegFolder, FaRegUserCircle } from 'react-icons/fa';

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props as Props;
const { Content } = await render(post);
const lang = getLangFromUrl(Astro.url);
const categoriesIndex = await getCollectionEntryByLang('categories', lang);
---

<section class="section blog-single">
  <div class="container">
    <div class="row mb-8">
      <Breadcrumb
        pageData={{
          indexTitle: categoriesIndex.data.title,
          indexPath: '/categories/',
          pageTitle: translateCategory(post.data.categories[0], lang)
        }}
      />
    </div>
    <div class="row justify-center">
      <div class="lg:col-10">
        <Image
          class="aspect-video rounded-xl object-contain"
          src={post.data.image!}
          alt={post.data.title}
          width={920}
          height={450}
        />
      </div>
      <div class="mt-10 max-w-[810px] lg:col-9">
        <h1 class="h2">
          {post.data.title}
        </h1>
        <div class="mt-6 mb-5 flex items-center space-x-2">
          <ul class="mb-4">
            <li class="mr-4 inline-block">
              <FaRegUserCircle className={'-mt-1 mr-2 inline-block'} />
              {humanize(post.data.author!)}
            </li>

            <li class="mr-4 inline-block">
              <FaRegCalendarAlt className={'-mt-1 mr-2 inline-block'} />
              {dateFormat(post.data.date!, lang)}
            </li>

            {
              post.body && (
                <li class="mr-4 inline-block">
                  <FaRegClock className={'-mt-1 mr-2 inline-block'} />
                  {readingTime(post.body, lang)}
                </li>
              )
            }

            <li class="mr-4 inline-block">
              <FaRegFolder className={'-mt-1 mr-2 inline-block'} />
              {
                post.data.categories.map((category, index) => (
                  <a href={`/categories/${slugify(category)}/`} class="hover:text-primary">
                    {translateCategory(category, lang)}
                    {index !== post.data.categories.length - 1 && ','}
                  </a>
                ))
              }
            </li>
          </ul>
        </div>

        <div class="content">
          <Content />
        </div>
      </div>
    </div>
  </div>
</section>
