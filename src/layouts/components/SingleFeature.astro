---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { AiFillCheckCircle } from 'react-icons/ai';

type Props = {
  feature: CollectionEntry<'home'>['data']['features']['ourFeatures'][number];
  index: number;
};

const { feature, index } = Astro.props;
---

<div class="gx-5 row items-center">
  <div class={`mt-6 lg:col-5 lg:mt-0 ${index % 2 === 0 ? 'lg:order-1' : 'lg:order-0'}`}>
    <div class="text-container">
      <h2>{feature.title}</h2>
      <p class="mt-4 text-lg">{feature.description}</p>
      <ul class="text-text-dark mt-6 lg:-ml-4">
        {
          feature.list.map((list) => (
            <li class="mb-2 flex items-center rounded px-4">
              <AiFillCheckCircle className="mr-3 fill-(--color-primary) text-white" />
              {list}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class={`lg:col-7 ${index % 2 === 0 ? 'lg:order-0' : 'lg:order-1'}`}>
    <div class="relative">
      <Image class="w-full object-contain" alt="service" width={667} height={498} src={feature.image} />
    </div>
  </div>
</div>
