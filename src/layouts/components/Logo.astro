---
import NotifycalIsologo from '@/assets/logos/notifycal-isologo-nosquares.svg';
import config from '@/config/config.json';

const {
  logoWidth,
  logoHeight,
  title
}: {
  logoWidth: any;
  logoHeight: any;
  title: string;
} = config.site;
---

<a href="/" class="navbar-brand block">
  <NotifycalIsologo
    style={{ width: logoWidth, height: logoHeight }}
    class="text-primary-500 drop-shadow-2xl"
    aria-label={title}
  />
</a>
