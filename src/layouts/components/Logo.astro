---
import config from '@/config/config.json';
import { useTranslatedPath } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';

import NotifycalIsologo from '@notifycal/shared/assets/logos/notifycal-isologo.svg';
import clsx from 'clsx';

const { className } = Astro.props;

const {
  title
}: {
  title: string;
} = config.site;

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<a href={translatePath('/')} class="navbar-brand block">
  <NotifycalIsologo class={clsx('logo', className)} aria-label={title} />
</a>
