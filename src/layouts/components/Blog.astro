---
import type { CollectionEntry } from 'astro:content';
import BlogCard from './blog/BlogCard.astro';

type Props = {
  posts: CollectionEntry<'blog'>[];
  columns?: string;
  title?: string;
  featured?: boolean;
};

const { posts, columns = 'md:col-6 lg:col-4', title, featured = false } = Astro.props;
---

{title && <h3 class="mb-4">{title}</h3>}
<div class:list={['row', { 'featured-posts': featured }]}>
  {
    posts.map((post) => (
      <div class={`mb-8 ${columns} flex`}>
        <BlogCard post={post} />
      </div>
    ))
  }
</div>
