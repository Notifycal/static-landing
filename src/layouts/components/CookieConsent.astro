---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import '@notifycal/shared/styles/cookie-consent-theme.css';
const { buttonSettingsText } = Astro.props;
---

<a data-cc="show-preferencesModal">
  {buttonSettingsText}
</a>

<script>
  import { denyAllGtag, gtagConsentConfig, updateAllGtagConsent } from '@notifycal/shared/cookies';
import { reset, run } from 'vanilla-cookieconsent';

  window.initializeCookieConsent = function() {
    document.body.classList.add('cc--theme');
    denyAllGtag();
    run(gtagConsentConfig('es', updateAllGtagConsent));
  };

  window.reinitializeCookieConsent = function() {
    if (typeof reset === 'function') {
      reset();
    }
    window.initializeCookieConsent();
  };

  window.initializeCookieConsent();
</script>

<script is:inline>
  // Handle Astro View Transitions navigation
  document.addEventListener('astro:page-load', function() {
    if (window.reinitializeCookieConsent) {
      window.reinitializeCookieConsent();
    }
  });
</script>
