---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import '@notifycal/shared/styles/cookie-consent-theme.css';
const { buttonSettingsText } = Astro.props;
---

<a data-cc="show-preferencesModal">
  {buttonSettingsText}
</a>

<script>
  import { getLangFromUrl } from '@/lib/i18n-const';
  import { gtagConsentConfig, updateAllGtagConsent } from '@notifycal/shared/cookies';
  import { run } from 'vanilla-cookieconsent';

  window.initializeCookieConsent = function () {
    const lang = getLangFromUrl(new URL(window.location.href));
    document.body.classList.add('cc--theme');
    run(gtagConsentConfig(lang, updateAllGtagConsent));
  };
</script>

<script is:inline>
  // Handle Astro View Transitions navigation
  document.addEventListener('astro:page-load', function () {
    if (window.initializeCookieConsent) {
      window.initializeCookieConsent();
    }
  });
</script>
