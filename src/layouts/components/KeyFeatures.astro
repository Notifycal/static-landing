---
import HomapageFeature from '@/layouts/function-components/HomapageFeature';
import { markdownify } from '@/lib/utils/textConverter';
import { Image } from 'astro:assets';
const { keyFeatures } = Astro.props;
const { title, description, featureList } = keyFeatures;
---

<section class="section key-feature relative">
  <Image
    class="absolute top-0 left-0 -z-[1] -translate-y-1/2"
    src="/images/feature-shape.webp"
    height={126}
    width={63}
    alt=""
  />
  <div class="container">
    <div class="row justify-between text-center lg:text-start">
      <div class="lg:col-5">
        <h2 set:html={markdownify(title)} />
      </div>
      <div class="mt-6 lg:col-5 lg:mt-0">
        <p set:html={markdownify(description)} />
      </div>
    </div>
    <HomapageFeature featureList={featureList} client:load />
  </div>
</section>
