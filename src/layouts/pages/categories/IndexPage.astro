---
import Blog from '@/components/Blog.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import BlogCategories from '@/components/blog/BlogCategories.astro';
import Base from '@/layouts/Base.astro';
import { getSinglePageByLang } from '@/lib/contentParser';
import { getCollectionEntryByLang } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';
import { getTaxonomy } from '@/lib/taxonomyParser.astro';

const lang = getLangFromUrl(Astro.url);
const categoriesIndex = await getCollectionEntryByLang('categories', lang);
const posts = await getSinglePageByLang('blog', lang);
const categories = await getTaxonomy('blog', 'categories');
---

<Base metaTitle={categoriesIndex?.data.metaTitle}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumb pageData={{ title: categoriesIndex.data.title }} />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <BlogCategories categories={categories} />
      <Blog posts={posts} />
    </div>
  </section>
</Base>
