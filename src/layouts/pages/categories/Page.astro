---
import Blog from '@/components/Blog.astro';
import BlogCategories from '@/components/blog/BlogCategories.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Base from '@/layouts/Base.astro';
import { translateCategory } from '@/lib/categoryTranslations';
import { getSinglePageByLang } from '@/lib/contentParser';
import { getCollectionEntryByLang } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';
import { getTaxonomy } from '@/lib/taxonomyParser.astro';
import taxonomyFilter from '@/lib/utils/taxonomyFilter';

type Props = {
  category: string;
  item: string;
};

const lang = getLangFromUrl(Astro.url);
const categoriesIndex = await getCollectionEntryByLang('categories', lang);
const categories = await getTaxonomy('blog', 'categories');
const { category, item } = Astro.props;

const posts = await getSinglePageByLang('blog', lang);
const filterByTags = taxonomyFilter(posts, 'categories', category);
const pageData = {
  indexTitle: categoriesIndex.data.title,
  indexPath: '/categories/',
  slug: item,
  pageTitle: translateCategory(category, lang)
};
---

<Base title={category}>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-content max-w-[883px]">
        <Breadcrumb pageData={pageData} />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <BlogCategories categories={categories} />
      <Blog posts={filterByTags} />
    </div>
  </section>
</Base>
