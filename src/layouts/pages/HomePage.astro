---
import Faq from '@/components/Faq.astro';
import Features from '@/components/Features.astro';
import Pricing from '@/components/Pricing.astro';
import Base from '@/layouts/Base.astro';
import Banner from '@/components/Banner.astro';
import Cta from '@/components/Cta.astro';
import Testimonial from '@/components/Testimonial.astro';
import { getCollectionEntryByLang } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';

const lang = getLangFromUrl(Astro.url);
const homepage = await getCollectionEntryByLang('home', lang);
const { banner, features, testimonial, faq, pricing, cta } = homepage.data;
---

<Base>
  <Banner banner={banner} />
  <Features features={features} />
  <Pricing pricing={pricing} />
  <Faq faq={faq} />
  <Testimonial testimonial={testimonial} />
  <Cta cta={cta} />
</Base>
