---
import TwSizeIndicator from '@/components/TwSizeIndicator.astro';
import SEO from '@/layouts/components/SEO.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import '@/styles/main.css';
import { ClientRouter } from 'astro:transitions';
import Unfont from 'unplugin-fonts/astro/component.astro';
import { getCollectionEntryByLang } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';

interface Props {
  title?: string;
  metaTitle?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  seoType?: 'website' | 'article' | 'product';
  seoSchema?: 'Organization' | 'SoftwareApplication' | 'FAQPage' | 'Offer' | 'BreadcrumbList';
  breadcrumbs?: Array<{ name: string; url: string }>;
  offers?: Array<{ name: string; price: string; currency: string }>;
  faqs?: Array<{ question: string; answer: string }>;
}

const {
  title,
  metaTitle,
  description: descriptionProp,
  image,
  noindex,
  canonical,
  seoType,
  seoSchema,
  breadcrumbs,
  offers,
  faqs
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const {
  data: { description }
} = await getCollectionEntryByLang('site', lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <SEO
      title={title}
      metaTitle={metaTitle}
      description={descriptionProp || description}
      image={image}
      canonical={canonical}
      noindex={noindex}
      type={seoType || 'website'}
      schema={seoSchema || 'SoftwareApplication'}
      breadcrumbs={breadcrumbs}
      offers={offers}
      faqs={faqs}
    />

    <Unfont />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };

      // Default consent denied needs to happen early, before loading GTM
      window.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'denied'
      });
    </script>
    <script is:inline>
      window.onServiceConfigReady = function (callback, configKey) {
        function executeCallback() {
          if (window.serviceConfig) {
            const configValue = window.serviceConfig[configKey];
            if (configValue) {
              callback(configValue, window.serviceConfig);
            }
          }
        }

        if (window.serviceConfig) {
          executeCallback();
        } else {
          window.addEventListener('serviceConfigReady', function () {
            executeCallback();
          });
        }
      };
      window.onServiceConfigReady((tagManagerId) => {
        if (!document.querySelector('noscript[data-gtm]')) {
          const noscript = document.createElement('noscript');
          noscript.setAttribute('data-gtm', 'true');
          noscript.innerHTML = `<iframe src="https://www.googletagmanager.com/ns.html?id=${tagManagerId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`;
          document.body.insertBefore(noscript, document.body.firstChild);
        }
      }, 'GOOGLE_TAG_MANAGER_ID');
      window.onServiceConfigReady((tagManagerId) => {
        const gtmSetupScript = document.createElement('script');
        gtmSetupScript.innerHTML = `
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${tagManagerId}');
        `;
        document.head.appendChild(gtmSetupScript);
      }, 'GOOGLE_TAG_MANAGER_ID');
    </script>
    <script type="text/javascript" src="/config.js" is:inline></script>
    <script src="/src/scripts/config-processor.ts"></script>

    <ClientRouter />
  </head>
  <body>
    <Header />
    <TwSizeIndicator />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { updateScrollMargins } from '@/lib/utils/scrollMargins';

  updateScrollMargins();

  window.addEventListener('resize', () => updateScrollMargins());
</script>
