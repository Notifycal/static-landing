---
import TwSizeIndicator from '@/components/TwSizeIndicator.astro';
import config from '@/config/config.json';
import { plainify } from '@/lib/utils/textConverter';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import '@/styles/main.css';
import { ClientRouter } from 'astro:transitions';
import Unfont from 'unplugin-fonts/astro/component.astro';
import { getCollectionEntryByLang } from '@/lib/i18n';
import { getLangFromUrl } from '@/lib/i18n-const';

const { titleProp, metaTitleProp, descriptionProp, imageProp, noindexProp, canonicalProp } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const {
  data: { description }
} = await getCollectionEntryByLang('site', lang);
const {
  site: { favicon, image, author, title, baseUrl }
} = config;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <!-- google font css -->
    <Unfont />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'denied'
      });
    </script>
    <script is:inline>
      window.onServiceConfigReady = function (callback, configKey) {
        function executeCallback() {
          if (window.serviceConfig) {
            const configValue = window.serviceConfig[configKey];
            if (configValue) {
              callback(configValue, window.serviceConfig);
            }
          }
        }

        if (window.serviceConfig) {
          executeCallback();
        } else {
          window.addEventListener('serviceConfigReady', function () {
            executeCallback();
          });
        }
      };
      window.onServiceConfigReady((tagManagerId) => {
        if (!document.querySelector('noscript[data-gtm]')) {
          const noscript = document.createElement('noscript');
          noscript.setAttribute('data-gtm', 'true');
          noscript.innerHTML = `<iframe src="https://www.googletagmanager.com/ns.html?id=${tagManagerId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`;
          document.body.insertBefore(noscript, document.body.firstChild);
        }
      }, 'GOOGLE_TAG_MANAGER_ID');
      window.onServiceConfigReady((tagManagerId) => {
        // Google Tag Manager setup
        const script = document.createElement('script');
        script.innerHTML = `
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${tagManagerId}');
        `;
        document.head.appendChild(script);
      }, 'GOOGLE_TAG_MANAGER_ID');
    </script>
    <script type="text/javascript" src="/config.js" is:inline></script>
    <script src="/src/scripts/config-processor.ts"></script>
    <!-- favicon -->
    <link rel="shortcut icon" href={favicon} />

    <!-- responsive meta -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />

    <!-- title -->
    <title>
      {plainify(metaTitleProp ? metaTitleProp : titleProp ? titleProp : title)}
    </title>

    <!-- canonical url -->
    {canonicalProp && <link rel="canonical" href={canonicalProp} item-prop="url" />}

    <!-- noindex robots -->
    {noindexProp && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={plainify(descriptionProp ? descriptionProp : description)} />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={author} />

    <!-- og-title -->
    <meta property="og:title" content={plainify(metaTitleProp ? metaTitleProp : titleProp ? titleProp : title)} />

    <!-- og-description -->
    <meta property="og:description" content={plainify(descriptionProp ? descriptionProp : description)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${baseUrl}/${Astro.url.pathname.replace('/', '')}`} />

    <!-- twitter-title -->
    <meta name="twitter:title" content={plainify(metaTitleProp ? metaTitleProp : titleProp ? titleProp : title)} />

    <!-- twitter-description -->
    <meta name="twitter:description" content={plainify(descriptionProp ? descriptionProp : description)} />

    <!-- og-image -->
    <meta property="og:image" content={`${baseUrl}${imageProp ? imageProp : image}`} />

    <!-- twitter-image -->
    <meta name="twitter:image" content={`${baseUrl}${imageProp ? imageProp : image}`} />
    <meta name="twitter:card" content="summaryLargeImage" />
  </head>
  <body>
    <Header />
    <TwSizeIndicator />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
