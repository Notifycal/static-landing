{
  "name": "static-landing",
  "type": "module",
  "version": "1.5.2",
  "scripts": {
    "dev": "$npm_execpath run dev:config && astro dev",
    "dev:config": "cp config/config.local.js public/config.js",
    "start": "astro dev",
    "build": "rm -rf public/config.js && astro check && astro build && $npm_execpath run build:config",
    "build:config": "cp config/config.skel.js dist/",
    "preview": "astro preview",
    "astro": "astro",
    "test": "echo \"Write some!\"",
    "lint": "eslint '**/*.{js,ts,jsx,tsx,cjs,mjs}' --no-error-on-unmatched-pattern",
    "lint:fix": "$npm_execpath run lint -- --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "$npm_execpath run prettier -- --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/partytown": "^2.1.3",
    "@astrojs/tailwind": "^5.1.5",
    "@playform/compress": "^0.1.7",
    "astro": "^5.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@iconify-json/ion": "^1.2.2",
    "@iconify-json/mdi": "^1.2.3",
    "@types/google.accounts": "^0.0.15",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.27.0",
    "astro-icon": "^1.1.5",
    "daisyui": "^4.12.23",
    "eslint": "9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-astro": "^1.2.4",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript-eslint": "^8.32.0"
  }
}
