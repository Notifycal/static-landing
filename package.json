{
  "name": "static-landing",
  "type": "module",
  "version": "2.8.1",
  "author": "Notifycal",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "$npm_execpath run clean && astro check && astro build && $npm_execpath run build:config",
    "build:config": "cp config/config.skel.js dist/ && rm -rf dist/config.local.js",
    "preview": "$npm_execpath run build && astro preview",
    "dev": "$npm_execpath run dev:config && astro dev",
    "dev:config": "cp config/config.local.js public/config.js",
    "lint": "eslint -c eslint.config.js",
    "lint:fix": "$npm_execpath run lint -- --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "$npm_execpath run prettier -- --write",
    "check": "$npm_execpath run types && $npm_execpath run lint && $npm_execpath run prettier && $npm_execpath run test && echo 'Everything ready to go upstream' || echo 'CAUTION: Have another look'",
    "types": "astro check && tsc",
    "test": "echo \"Write some!\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "4.3.14",
    "@astrojs/react": "4.4.2",
    "@astrojs/rss": "4.0.17",
    "@astrojs/sitemap": "^3.4.2",
    "@justinribeiro/lite-youtube": "^1.8.2",
    "@mantine/core": "^8.2.4",
    "@notifycal/shared": "7.16.2",
    "@playform/compress": "^0.2.0",
    "@tabler/icons-react": "^3.34.1",
    "astro": "5.18.1",
    "astro-auto-import": "^0.5.0",
    "date-fns": "^4.1.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-feather": "^2.0.10",
    "react-icons": "^5.5.0",
    "react-youtube": "^10.1.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "shufflejs": "^7.0.0",
    "swiper": "^12.0.0",
    "vanilla-cookieconsent": "^3.1.0",
    "vite": "^7.0.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "unplugin-fonts": "^1.4.0"
  }
}
