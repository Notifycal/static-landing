{
  "name": "static-landing",
  "type": "module",
  "version": "1.6.4",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "$npm_execpath run clean && astro check && astro build && $npm_execpath run build:config",
    "build:config": "cp config/config.skel.js dist/ && rm -rf dist/config.local.js",
    "preview": "$npm_execpath run build && astro preview",
    "dev": "$npm_execpath run dev:config && astro dev",
    "dev:config": "cp config/config.local.js public/config.js",
    "lint": "eslint '**/*.{js,ts,jsx,tsx,cjs,mjs}' --no-error-on-unmatched-pattern",
    "lint:fix": "$npm_execpath run lint -- --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "$npm_execpath run prettier -- --write",
    "check": "$npm_execpath run types && $npm_execpath run lint && $npm_execpath run prettier && $npm_execpath run test && echo 'Everything ready to go upstream' || echo 'CAUTION: Have another look'",
    "types": "tsc",
    "test": "echo \"Write some!\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/react": "^4.3.0",
    "@mantine/core": "^8.2.2",
    "@notifycal/shared": "^7.0.0",
    "@playform/compress": "^0.2.0",
    "@tabler/icons-react": "^3.34.1",
    "astro": "^5.12.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@iconify-json/ion": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/vite": "^4.1.11",
    "@types/google.accounts": "^0.0.17",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "astro-icon": "^1.1.5",
    "daisyui": "^5.0.50",
    "eslint": "9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript-eslint": "^8.36.0"
  }
}
